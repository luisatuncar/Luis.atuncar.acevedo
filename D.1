    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.interpolate import CubicSpline\n",
        "from scipy.optimize import brentq\n",
        "\n",
        "# =========================================\n",
        "# DATOS EXPERIMENTALES\n",
        "# =========================================\n",
        "\n",
        "f = np.array([\n",
        "    100,120,145,170,200,235,270,310,355,405,\n",
        "    460,520,585,655,730,810,895,985,1080,1180,\n",
        "    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,\n",
        "    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,\n",
        "    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2\n",
        "])\n",
        "\n",
        "# =========================================\n",
        "# UMBRAL\n",
        "# =========================================\n",
        "\n",
        "Z_th = 150\n",
        "\n",
        "# =========================================\n",
        "# SPLINE CÚBICO NATURAL\n",
        "# =========================================\n",
        "\n",
        "spline = CubicSpline(f, Z, bc_type='natural')\n",
        "\n",
        "# =========================================\n",
        "# FUNCIÓN A RESOLVER\n",
        "# |Z|(f) - Z_th = 0\n",
        "# =========================================\n",
        "\n",
        "def g(x):\n",
        "    return spline(x) - Z_th\n",
        "\n",
        "# =========================================\n",
        "# BUSCAR CAMBIOS DE SIGNO\n",
        "# =========================================\n",
        "\n",
        "raices = []\n",
        "\n",
        "for i in range(len(f)-1):\n",
        "\n",
        "    x1 = f[i]\n",
        "    x2 = f[i+1]\n",
        "\n",
        "    y1 = g(x1)\n",
        "    y2 = g(x2)\n",
        "\n",
        "    # detectar cambio de signo\n",
        "    if y1 * y2 < 0:\n",
        "\n",
        "        # método de Brent/Bisección robusta\n",
        "        raiz = brentq(g, x1, x2)\n",
        "\n",
        "        raices.append(raiz)\n",
        "\n",
        "# =========================================\n",
        "# RESULTADOS\n",
        "# =========================================\n",
        "\n",
        "print(\"===== RAÍCES DE |Z|(f) - 150 =====\\n\")\n",
        "\n",
        "for i, r in enumerate(raices):\n",
        "\n",
        "    print(f\"Raíz {i+1} = {r:.4f} Hz\")\n",
        "\n",
        "# =========================================\n",
        "# INTERPRETACIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== INTERPRETACIÓN =====\\n\")\n",
        "\n",
        "if len(raices) >= 2:\n",
        "\n",
        "    print(\"La banda de operación segura es:\")\n",
        "\n",
        "    print(f\"\\n{raices[0]:.4f} Hz < f < {raices[1]:.4f} Hz\")\n",
        "\n",
        "    print(\"\\nEn ese intervalo:\")\n",
        "    print(\"|Z|(f) permanece por debajo del umbral\")\n",
        "    print(\"de 150 ohm.\")\n",
        "\n",
        "# =========================================\n",
        "# EXPLICACIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== EXPLICACIÓN =====\\n\")\n",
        "\n",
        "print(\"1. Se construyó un spline cúbico natural.\")\n",
        "print(\"2. Se definió la función:\")\n",
        "print(\"      g(f) = |Z|(f) - 150\")\n",
        "print(\"3. Se buscaron cambios de signo.\")\n",
        "print(\"4. Se aplicó el método de Brent\")\n",
        "print(\"   para encontrar las raíces.\")"
      ],
