      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.interpolate import CubicSpline\n",
        "\n",
        "# =========================================\n",
        "# DATOS EXPERIMENTALES\n",
        "# =========================================\n",
        "\n",
        "f = np.array([\n",
        "    100,120,145,170,200,235,270,310,355,405,\n",
        "    460,520,585,655,730,810,895,985,1080,1180,\n",
        "    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,\n",
        "    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,\n",
        "    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2\n",
        "])\n",
        "\n",
        "# =========================================\n",
        "# SPLINE CÚBICO NATURAL\n",
        "# =========================================\n",
        "\n",
        "# bc_type='natural' -> spline cúbico natural\n",
        "spline = CubicSpline(f, Z, bc_type='natural')\n",
        "\n",
        "# =========================================\n",
        "# MALLA FINA\n",
        "# =========================================\n",
        "\n",
        "f_fina = np.linspace(100, 2730, 1000)\n",
        "\n",
        "# evaluar spline\n",
        "Z_spline = spline(f_fina)\n",
        "\n",
        "# =========================================\n",
        "# MOSTRAR ECUACIONES DEL SPLINE\n",
        "# =========================================\n",
        "\n",
        "print(\"===== SPLINE CÚBICO NATURAL =====\\n\")\n",
        "\n",
        "print(\"Número de intervalos:\")\n",
        "print(len(f)-1)\n",
        "\n",
        "print(\"\\nCoeficientes del spline:\")\n",
        "print(\"\\nCada fila corresponde a un intervalo.\")\n",
        "\n",
        "print(\"\\nFormato:\")\n",
        "print(\"[a_i, b_i, c_i, d_i]\")\n",
        "\n",
        "print(\"\\nSpline.c =\\n\")\n",
        "print(spline.c)\n",
        "\n",
        "# =========================================\n",
        "# GRÁFICA\n",
        "# =========================================\n",
        "\n",
        "plt.figure(figsize=(12,7))\n",
        "\n",
        "# datos experimentales\n",
        "plt.scatter(f, Z,\n",
        "            color='red',\n",
        "            label='Datos experimentales')\n",
        "\n",
        "# spline\n",
        "plt.plot(f_fina, Z_spline,\n",
        "         color='blue',\n",
        "         linewidth=2,\n",
        "         label='Spline cúbico natural')\n",
        "\n",
        "plt.xlabel('Frecuencia (Hz)')\n",
        "plt.ylabel('|Z| (ohm)')\n",
        "\n",
        "plt.title('Spline cúbico natural para 30 puntos')\n",
        "\n",
        "plt.grid()\n",
        "plt.legend()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# =========================================\n",
        "# EVALUACIÓN DE EJEMPLO\n",
        "# =========================================\n",
        "\n",
        "f_eval = 1000\n",
        "\n",
        "Z_eval = spline(f_eval)\n",
        "\n",
        "print(\"\\n===== EVALUACIÓN =====\\n\")\n",
        "\n",
        "print(f\"|Z|(1000 Hz) = {Z_eval:.4f} ohm\")\n",
        "\n",
        "# =========================================\n",
        "# EXPLICACIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== EXPLICACIÓN =====\\n\")\n",
        "\n",
        "print(\"Se construyó un spline cúbico natural\")\n",
        "print(\"utilizando los 30 puntos experimentales.\")\n",
        "\n",
        "print(\"\\nEl spline está formado por polinomios\")\n",
        "print(\"cúbicos definidos por intervalos.\")\n",
        "\n",
        "print(\"\\nLas condiciones naturales imponen:\")\n",
        "print(\"segunda derivada igual a cero\")\n",
        "print(\"en los extremos del intervalo.\")\n",
        "\n",
        "print(\"\\nEl spline proporciona una curva suave\")\n",
        "print(\"y evita oscilaciones del fenómeno de Runge.\")"
      ],
