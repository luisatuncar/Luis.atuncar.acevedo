        "# ==========================================================\n",
        "# DERIVACIÓN NUMÉRICA\n",
        "# Diferencia centrada de orden 2 y orden 4\n",
        "# ==========================================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# ==========================================================\n",
        "# DATOS\n",
        "# ==========================================================\n",
        "\n",
        "f = np.array([\n",
        "    10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5,\n",
        "    30.0, 32.5, 35.0, 37.5, 40.0, 42.5, 45.0, 47.5,\n",
        "    50.0, 52.5, 55.0, 57.5, 60.0, 62.5, 65.0, 67.5,\n",
        "    70.0, 72.5, 75.0, 77.5, 80.0, 82.5, 85.0, 87.5,\n",
        "    90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5\n",
        "])\n",
        "\n",
        "V = np.array([\n",
        "    0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401,\n",
        "    1.482, 1.551, 1.216, 1.048, 0.866, 0.689, 0.521, 0.364,\n",
        "    0.223, 0.103, 0.012, -0.041, -0.057, -0.034, 0.018, 0.096,\n",
        "    0.197, 0.318, 0.452, 0.579, 0.700, 0.809, 0.611, 0.688,\n",
        "    0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004\n",
        "])\n",
        "\n",
        "# ==========================================================\n",
        "# PASO ENTRE DATOS\n",
        "# ==========================================================\n",
        "\n",
        "h = 2.5  # kHz\n",
        "\n",
        "# ==========================================================\n",
        "# FUNCIÓN DIFERENCIA CENTRADA ORDEN 2\n",
        "# ==========================================================\n",
        "\n",
        "def diferencia_orden2(i):\n",
        "    return (V[i+1] - V[i-1]) / (2*h)\n",
        "\n",
        "# ==========================================================\n",
        "# FUNCIÓN DIFERENCIA CENTRADA ORDEN 4\n",
        "# ==========================================================\n",
        "\n",
        "def diferencia_orden4(i):\n",
        "    return (-V[i+2] + 8*V[i+1] - 8*V[i-1] + V[i-2]) / (12*h)\n",
        "\n",
        "# ==========================================================\n",
        "# ÍNDICES DE LAS FRECUENCIAS\n",
        "# ==========================================================\n",
        "\n",
        "i40 = np.where(f == 40.0)[0][0]\n",
        "i70 = np.where(f == 70.0)[0][0]\n",
        "i100 = np.where(f == 100.0)[0][0]\n",
        "\n",
        "# ==========================================================\n",
        "# CÁLCULOS\n",
        "# ==========================================================\n",
        "\n",
        "dVdf40_o2 = diferencia_orden2(i40)\n",
        "dVdf40_o4 = diferencia_orden4(i40)\n",
        "\n",
        "dVdf70_o2 = diferencia_orden2(i70)\n",
        "dVdf70_o4 = diferencia_orden4(i70)\n",
        "\n",
        "dVdf100_o2 = diferencia_orden2(i100)\n",
        "dVdf100_o4 = diferencia_orden4(i100)\n",
        "\n",
        "# ==========================================================\n",
        "# RESULTADOS\n",
        "# ==========================================================\n",
        "\n",
        "print(\"========================================\")\n",
        "print(\" DERIVACIÓN NUMÉRICA\")\n",
        "print(\" Diferencias centradas\")\n",
        "print(\"========================================\\n\")\n",
        "\n",
        "print(\"f = 40.0 kHz\")\n",
        "print(\"Orden 2 =\", round(dVdf40_o2, 5), \"V/kHz\")\n",
        "print(\"Orden 4 =\", round(dVdf40_o4, 5), \"V/kHz\\n\")\n",
        "\n",
        "print(\"f = 70.0 kHz\")\n",
        "print(\"Orden 2 =\", round(dVdf70_o2, 5), \"V/kHz\")\n",
        "print(\"Orden 4 =\", round(dVdf70_o4, 5), \"V/kHz\\n\")\n",
        "\n",
        "print(\"f = 100.0 kHz\")\n",
        "print(\"Orden 2 =\", round(dVdf100_o2, 5), \"V/kHz\")\n",
        "print(\"Orden 4 =\", round(dVdf100_o4, 5), \"V/kHz\")"
