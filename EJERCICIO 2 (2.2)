      "source": [
        "# ==========================================================\n",
        "# DERIVACIÓN NUMÉRICA\n",
        "# Fórmula progresiva de orden 2\n",
        "# dV/df en f = 10.0 kHz\n",
        "# ==========================================================\n",
        "\n",
        "# Datos de la tabla\n",
        "f0 = 10.0\n",
        "f1 = 12.5\n",
        "f2 = 15.0\n",
        "\n",
        "V0 = 0.842\n",
        "V1 = 0.911\n",
        "V2 = 0.986\n",
        "\n",
        "# Paso uniforme\n",
        "h = 2.5  # kHz\n",
        "\n",
        "# ==========================================================\n",
        "# FÓRMULA PROGRESIVA DE ORDEN 2\n",
        "#\n",
        "# f'(x0) ≈ [-3f(x0) + 4f(x1) - f(x2)] / (2h)\n",
        "# ==========================================================\n",
        "\n",
        "dVdf = (-3*V0 + 4*V1 - V2) / (2*h)\n",
        "\n",
        "# ==========================================================\n",
        "# RESULTADO\n",
        "# ==========================================================\n",
        "\n",
        "print(\"======================================\")\n",
        "print(\" DERIVACIÓN NUMÉRICA\")\n",
        "print(\" Fórmula progresiva de orden 2\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(\"f = 10.0 kHz\")\n",
        "print(\"dV/df =\", round(dVdf, 5), \"V/kHz\")"
      ],
