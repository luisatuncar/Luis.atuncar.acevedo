      "source": [
        "# Interpolación de Lagrange de segundo grado\n",
        "# Ensayo de telemetría biomédica\n",
        "\n",
        "def lagrange(x, puntos):\n",
        "    \"\"\"\n",
        "    x       -> valor a interpolar\n",
        "    puntos  -> lista de tuplas (xi, yi)\n",
        "    \"\"\"\n",
        "\n",
        "    n = len(puntos)\n",
        "    resultado = 0\n",
        "\n",
        "    for i in range(n):\n",
        "        xi, yi = puntos[i]\n",
        "\n",
        "        Li = 1\n",
        "\n",
        "        for j in range(n):\n",
        "            if i != j:\n",
        "                xj, yj = puntos[j]\n",
        "                Li *= (x - xj) / (xi - xj)\n",
        "\n",
        "        resultado += yi * Li\n",
        "\n",
        "    return resultado\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# 1) V(41.0 kHz)\n",
        "# =====================================================\n",
        "\n",
        "puntos_V41 = [\n",
        "    (37.5, 1.048),\n",
        "    (40.0, 0.866),\n",
        "    (42.5, 0.689)\n",
        "]\n",
        "\n",
        "V41 = lagrange(41.0, puntos_V41)\n",
        "\n",
        "print(\"V(41.0 kHz) =\", round(V41, 3), \"V\")\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# 2) |Z|(41.0 kHz)\n",
        "# =====================================================\n",
        "\n",
        "puntos_Z41 = [\n",
        "    (37.5, 145.2),\n",
        "    (40.0, 145.8),\n",
        "    (42.5, 147.3)\n",
        "]\n",
        "\n",
        "Z41 = lagrange(41.0, puntos_Z41)\n",
        "\n",
        "print(\"|Z|(41.0 kHz) =\", round(Z41, 2), \"ohms\")\n",
        "\n",
        "\n",
