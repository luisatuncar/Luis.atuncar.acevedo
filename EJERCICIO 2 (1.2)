        "# ==========================================================\n",
        "# SPLINE CÚBICO NATURAL PARA TODA LA TABLA\n",
        "# Telemetría biomédica\n",
        "# ==========================================================\n",
        "\n",
        "import numpy as np\n",
        "from scipy.interpolate import CubicSpline\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================================\n",
        "# TABLA COMPLETA DE DATOS\n",
        "# ==========================================================\n",
        "\n",
        "f = np.array([\n",
        "    10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5,\n",
        "    30.0, 32.5, 35.0, 37.5, 40.0, 42.5, 45.0, 47.5,\n",
        "    50.0, 52.5, 55.0, 57.5, 60.0, 62.5, 65.0, 67.5,\n",
        "    70.0, 72.5, 75.0, 77.5, 80.0, 82.5, 85.0, 87.5,\n",
        "    90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5\n",
        "])\n",
        "\n",
        "V = np.array([\n",
        "    0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401,\n",
        "    1.482, 1.551, 1.216, 1.048, 0.866, 0.689, 0.521, 0.364,\n",
        "    0.223, 0.103, 0.012, -0.041, -0.057, -0.034, 0.018, 0.096,\n",
        "    0.197, 0.318, 0.452, 0.579, 0.700, 0.809, 0.611, 0.688,\n",
        "    0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    182.4, 178.9, 175.1, 171.0, 166.8, 162.7, 158.9, 155.4,\n",
        "    152.0, 149.0, 146.1, 145.2, 145.8, 147.3, 149.9, 153.5,\n",
        "    158.0, 163.2, 168.9, 174.8, 180.5, 186.2, 191.5, 196.2,\n",
        "    200.1, 203.1, 205.2, 206.3, 206.1, 204.7, 198.0, 194.4,\n",
        "    190.9, 187.8, 185.1, 183.0, 181.6, 180.8, 180.6, 180.9\n",
        "])\n",
        "\n",
        "# ==========================================================\n",
        "# CONSTRUCCIÓN DEL SPLINE CÚBICO NATURAL\n",
        "# bc_type='natural' -> condiciones naturales\n",
        "# ==========================================================\n",
        "\n",
        "spline_V = CubicSpline(f, V, bc_type='natural')\n",
        "spline_Z = CubicSpline(f, Z, bc_type='natural')\n",
        "\n",
        "# ==========================================================\n",
        "# EVALUACIONES PEDIDAS\n",
        "# ==========================================================\n",
        "\n",
        "V41 = spline_V(41.0)\n",
        "Z41 = spline_Z(41.0)\n",
        "\n",
        "V73 = spline_V(73.0)\n",
        "Z73 = spline_Z(73.0)\n",
        "\n",
        "# ==========================================================\n",
        "# RESULTADOS\n",
        "# ==========================================================\n",
        "\n",
        "print(\"====================================\")\n",
        "print(\" SPLINE CÚBICO NATURAL\")\n",
        "print(\"====================================\\n\")\n",
        "\n",
        "print(f\"V(41.0 kHz)   = {V41:.5f} V\")\n",
        "print(f\"|Z|(41.0 kHz)= {Z41:.5f} ohms\\n\")\n",
        "\n",
        "print(f\"V(73.0 kHz)   = {V73:.5f} V\")\n",
        "print(f\"|Z|(73.0 kHz)= {Z73:.5f} ohms\")\n",
        "\n",
        "# ==========================================================\n",
        "# GRAFICAR SPLINES\n",
        "# ==========================================================\n",
        "\n",
        "x = np.linspace(min(f), max(f), 1000)\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "# ---------------------------\n",
        "# Gráfica V(f)\n",
        "# ---------------------------\n",
        "\n",
        "plt.subplot(1,2,1)\n",
        "\n",
        "plt.plot(f, V, 'o', label='Datos')\n",
        "plt.plot(x, spline_V(x), label='Spline cúbico')\n",
        "\n",
        "plt.xlabel('Frecuencia (kHz)')\n",
        "plt.ylabel('Voltaje V')\n",
        "plt.title('Spline cúbico natural para V(f)')\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "\n",
        "# ---------------------------\n",
        "# Gráfica |Z|(f)\n",
        "# ---------------------------\n",
        "\n",
        "plt.subplot(1,2,2)\n",
        "\n",
        "plt.plot(f, Z, 'o', label='Datos')\n",
        "plt.plot(x, spline_Z(x), label='Spline cúbico')\n",
        "\n",
        "plt.xlabel('Frecuencia (kHz)')\n",
        "plt.ylabel('|Z| (ohms)')\n",
        "plt.title('Spline cúbico natural para |Z|(f)')\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
