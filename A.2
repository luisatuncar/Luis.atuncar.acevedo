    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# =========================================\n",
        "# DATOS\n",
        "# =========================================\n",
        "\n",
        "f = np.array([\n",
        "    100,120,145,170,200,235,270,310,355,405,\n",
        "    460,520,585,655,730,810,895,985,1080,1180,\n",
        "    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,\n",
        "    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,\n",
        "    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2\n",
        "])\n",
        "\n",
        "# =========================================\n",
        "# BUSCAR MÍNIMO LOCAL\n",
        "# =========================================\n",
        "\n",
        "indice_min = np.argmin(Z)\n",
        "\n",
        "f_min = f[indice_min]\n",
        "Z_min = Z[indice_min]\n",
        "\n",
        "# =========================================\n",
        "# MOSTRAR RESULTADOS\n",
        "# =========================================\n",
        "\n",
        "print(\"===== MÍNIMO LOCAL =====\\n\")\n",
        "\n",
        "print(f\"Frecuencia aproximada = {f_min} Hz\")\n",
        "print(f\"|Z|min = {Z_min} ohm\")\n",
        "\n",
        "# =========================================\n",
        "# GRÁFICO\n",
        "# =========================================\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "plt.plot(f, Z,\n",
        "         marker='o',\n",
        "         color='blue',\n",
        "         linewidth=2,\n",
        "         label='|Z|(f)')\n",
        "\n",
        "# marcar mínimo\n",
        "plt.scatter(f_min, Z_min,\n",
        "            color='red',\n",
        "            s=100,\n",
        "            label='Mínimo local')\n",
        "\n",
        "plt.axvline(f_min,\n",
        "            color='red',\n",
        "            linestyle='--')\n",
        "\n",
        "plt.xlabel('Frecuencia (Hz)')\n",
        "plt.ylabel('|Z| (ohm)')\n",
        "\n",
        "plt.title('Identificación del mínimo local')\n",
        "\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# =========================================\n",
        "# DISCUSIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== DISCUSIÓN =====\\n\")\n",
        "\n",
        "print(\"Visualmente se observa un mínimo local\")\n",
        "print(\"en la curva de impedancia.\")\n",
        "\n",
        "print(f\"El mínimo ocurre aproximadamente en {f_min} Hz,\")\n",
        "print(f\"con un valor de |Z| ≈ {Z_min} ohm.\")\n",
        "\n",
        "print(\"La curva disminuye inicialmente y luego aumenta,\")\n",
        "print(\"indicando un comportamiento típico de sistemas\")\n",
        "print(\"con componentes resistivos y reactivos.\")"
      ],
