    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.interpolate import CubicSpline\n",
        "\n",
        "# =========================================\n",
        "# DATOS EXPERIMENTALES\n",
        "# =========================================\n",
        "\n",
        "f = np.array([\n",
        "    100,120,145,170,200,235,270,310,355,405,\n",
        "    460,520,585,655,730,810,895,985,1080,1180,\n",
        "    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,\n",
        "    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,\n",
        "    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2\n",
        "])\n",
        "\n",
        "# =========================================\n",
        "# SPLINE CÚBICO NATURAL\n",
        "# =========================================\n",
        "\n",
        "spline = CubicSpline(f, Z, bc_type='natural')\n",
        "\n",
        "# =========================================\n",
        "# PRIMERA DERIVADA\n",
        "# =========================================\n",
        "\n",
        "d1 = spline.derivative()\n",
        "\n",
        "# =========================================\n",
        "# SEGUNDA DERIVADA\n",
        "# =========================================\n",
        "\n",
        "d2 = spline.derivative(2)\n",
        "\n",
        "# =========================================\n",
        "# BUSCAR EL MÍNIMO\n",
        "# =========================================\n",
        "\n",
        "# malla fina\n",
        "f_fina = np.linspace(100, 2730, 5000)\n",
        "\n",
        "# derivada primera\n",
        "d1_fina = d1(f_fina)\n",
        "\n",
        "# detectar cambio de signo\n",
        "for i in range(len(d1_fina)-1):\n",
        "\n",
        "    if d1_fina[i] < 0 and d1_fina[i+1] > 0:\n",
        "\n",
        "        f_min = f_fina[i]\n",
        "        break\n",
        "\n",
        "# =========================================\n",
        "# EVALUAR SEGUNDA DERIVADA\n",
        "# =========================================\n",
        "\n",
        "segunda_derivada = d2(f_min)\n",
        "\n",
        "# =========================================\n",
        "# RESULTADOS\n",
        "# =========================================\n",
        "\n",
        "print(\"===== RESULTADOS =====\\n\")\n",
        "\n",
        "print(f\"Frecuencia del mínimo ≈ {f_min:.4f} Hz\")\n",
        "\n",
        "print(f\"\\nd²|Z|/df² = {segunda_derivada:.8f}\")\n",
        "\n",
        "# =========================================\n",
        "# ANALIZAR SIGNO\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== ANÁLISIS =====\\n\")\n",
        "\n",
        "if segunda_derivada > 0:\n",
        "\n",
        "    print(\"La segunda derivada es POSITIVA.\")\n",
        "\n",
        "    print(\"\\nEl punto corresponde a un mínimo local estable.\")\n",
        "\n",
        "    print(\"\\nLa curva es cóncava hacia arriba\")\n",
        "    print(\"alrededor de esa frecuencia.\")\n",
        "\n",
        "elif segunda_derivada < 0:\n",
        "\n",
        "    print(\"La segunda derivada es NEGATIVA.\")\n",
        "\n",
        "    print(\"\\nEl punto corresponde a un máximo local.\")\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\"La segunda derivada es aproximadamente cero.\")\n",
        "\n",
        "    print(\"\\nNo puede concluirse estabilidad claramente.\")\n",
        "\n",
        "# =========================================\n",
        "# EXPLICACIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== EXPLICACIÓN =====\\n\")\n",
        "\n",
        "print(\"Se utilizó la derivada analítica del spline\")\n",
        "print(\"para calcular la segunda derivada.\")\n",
        "\n",
        "print(\"\\nEl cambio de signo de la primera derivada\")\n",
        "print(\"permite localizar el mínimo.\")\n",
        "\n",
        "print(\"\\nLuego se evaluó d²|Z|/df² en esa frecuencia\")\n",
        "print(\"para estudiar la estabilidad del mínimo.\")"
      ],
