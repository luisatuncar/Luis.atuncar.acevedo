    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.interpolate import lagrange\n",
        "\n",
        "# =========================================\n",
        "# DATOS EXPERIMENTALES\n",
        "# =========================================\n",
        "\n",
        "f = np.array([\n",
        "    100,120,145,170,200,235,270,310,355,405,\n",
        "    460,520,585,655,730,810,895,985,1080,1180,\n",
        "    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730\n",
        "])\n",
        "\n",
        "Z = np.array([\n",
        "    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,\n",
        "    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,\n",
        "    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2\n",
        "])\n",
        "\n",
        "# =========================================\n",
        "# MÉTODO MATRICIAL\n",
        "# INTERPOLACIÓN POLINÓMICA\n",
        "# =========================================\n",
        "\n",
        "# grado adecuado\n",
        "grado = 5\n",
        "\n",
        "# matriz de Vandermonde\n",
        "A = np.vander(f, grado + 1)\n",
        "\n",
        "# resolver sistema matricial\n",
        "coef = np.linalg.lstsq(A, Z, rcond=None)[0]\n",
        "\n",
        "# construir polinomio\n",
        "P = np.poly1d(coef)\n",
        "\n",
        "print(\"===== MÉTODO MATRICIAL =====\\n\")\n",
        "\n",
        "print(\"Coeficientes del polinomio:\\n\")\n",
        "print(coef)\n",
        "\n",
        "print(\"\\nPolinomio obtenido:\\n\")\n",
        "print(P)\n",
        "\n",
        "# =========================================\n",
        "# INTERPOLACIÓN DE LAGRANGE\n",
        "# =========================================\n",
        "\n",
        "# seleccionar puntos representativos\n",
        "f_lag = np.array([100, 730, 2730])\n",
        "Z_lag = np.array([152.3, 130.9, 159.2])\n",
        "\n",
        "# construir polinomio de Lagrange\n",
        "L = lagrange(f_lag, Z_lag)\n",
        "\n",
        "print(\"\\n===== POLINOMIO DE LAGRANGE =====\\n\")\n",
        "\n",
        "print(L)\n",
        "\n",
        "# =========================================\n",
        "# MALLA FINA\n",
        "# =========================================\n",
        "\n",
        "f_fina = np.linspace(100, 2730, 500)\n",
        "\n",
        "Z_matricial = P(f_fina)\n",
        "\n",
        "Z_lagrange = L(f_fina)\n",
        "\n",
        "# =========================================\n",
        "# GRÁFICAS\n",
        "# =========================================\n",
        "\n",
        "plt.figure(figsize=(12,7))\n",
        "\n",
        "# datos experimentales\n",
        "plt.scatter(f, Z,\n",
        "            color='black',\n",
        "            label='Datos experimentales')\n",
        "\n",
        "# polinomio matricial\n",
        "plt.plot(f_fina, Z_matricial,\n",
        "         color='blue',\n",
        "         linewidth=2,\n",
        "         label='Método matricial (grado 5)')\n",
        "\n",
        "# Lagrange\n",
        "plt.plot(f_fina, Z_lagrange,\n",
        "         color='red',\n",
        "         linestyle='--',\n",
        "         linewidth=2,\n",
        "         label='Lagrange')\n",
        "\n",
        "plt.xlabel('Frecuencia (Hz)')\n",
        "plt.ylabel('|Z| (ohm)')\n",
        "\n",
        "plt.title('Interpolación polinómica')\n",
        "\n",
        "plt.grid()\n",
        "plt.legend()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# =========================================\n",
        "# DISCUSIÓN\n",
        "# =========================================\n",
        "\n",
        "print(\"\\n===== DISCUSIÓN =====\\n\")\n",
        "\n",
        "print(\"El método matricial genera un polinomio\")\n",
        "print(\"que ajusta adecuadamente toda la tendencia global.\")\n",
        "\n",
        "print(\"\\nLa interpolación de Lagrange utiliza\")\n",
        "print(\"puntos específicos para construir el polinomio.\")\n",
        "\n",
        "print(\"\\nEl polinomio de grado moderado evita\")\n",
        "print(\"las oscilaciones del fenómeno de Runge\")\n",
        "print(\"y representa mejor el comportamiento físico.\")"
      ],
