        "# ==========================================================\n",
        "# MÉTODO DE BISECCIÓN\n",
        "# Localización de la primera raíz de V(f)\n",
        "# ==========================================================\n",
        "\n",
        "# Intervalo inicial encontrado:\n",
        "# [55.0 , 57.5] kHz\n",
        "\n",
        "# Datos de la tabla\n",
        "f1 = 55.0\n",
        "V1 = 0.012\n",
        "\n",
        "f2 = 57.5\n",
        "V2 = -0.041\n",
        "\n",
        "# ==========================================================\n",
        "# FUNCIÓN INTERPOLADA LINEALMENTE\n",
        "# ENTRE LOS DOS PUNTOS\n",
        "# ==========================================================\n",
        "\n",
        "def V(f):\n",
        "    return V1 + (V2 - V1)*(f - f1)/(f2 - f1)\n",
        "\n",
        "# ==========================================================\n",
        "# MÉTODO DE BISECCIÓN\n",
        "# ==========================================================\n",
        "\n",
        "a = 55.0\n",
        "b = 57.5\n",
        "\n",
        "tolerancia = 0.0001\n",
        "\n",
        "print(\"===================================\")\n",
        "print(\" MÉTODO DE BISECCIÓN\")\n",
        "print(\" Primera raíz\")\n",
        "print(\"===================================\\n\")\n",
        "\n",
        "iteracion = 1\n",
        "\n",
        "while (b - a) / 2 > tolerancia:\n",
        "\n",
        "    m = (a + b) / 2\n",
        "\n",
        "    Vm = V(m)\n",
        "\n",
        "    print(\"Iteración\", iteracion)\n",
        "    print(\"a =\", round(a,6))\n",
        "    print(\"b =\", round(b,6))\n",
        "    print(\"m =\", round(m,6))\n",
        "    print(\"V(m) =\", round(Vm,6))\n",
        "    print()\n",
        "\n",
        "    # Cambio de signo\n",
        "    if V(a) * Vm < 0:\n",
        "        b = m\n",
        "    else:\n",
        "        a = m\n",
        "\n",
        "    iteracion += 1\n",
        "\n",
        "# ==========================================================\n",
        "# RESULTADO FINAL\n",
        "# ==========================================================\n",
        "\n",
        "raiz = (a + b) / 2\n",
        "\n",
        "print(\"===================================\")\n",
        "print(\" RESULTADO\")\n",
        "print(\"===================================\\n\")\n",
        "\n",
        "print(\"Primera raíz ≈\", round(raiz,6), \"kHz\")\n",
        "print(\"V(f) ≈\", round(V(raiz),8), \"V\")"
      ],
